# Researcher owner key. Required wherever the Next.js app serves /api/haebom.
# Unset, empty, or shorter than 16 characters: researcher API and workspace fail closed.
# Generate a value with: openssl rand -base64 32
# Set the same name on Vercel. Do not commit a real key.
HAEBOM_ADMIN_KEY=

# Neon connection string injected by the Vercel Neon integration.
# Leave unset to use the local JSON file (data/haebom.json).
DATABASE_URL=

# Set to file to force the JSON store even when DATABASE_URL is present.
HAEBOM_STORE=

# Optional directory for the JSON store. Tests set this to a temp folder.
HAEBOM_DATA_DIR=

# Apps in Toss console appName. Ours is 해봄리서치 → haebomresearch.
# The existing 해봄 listing is someone else's app — do not use haebom.
# Fills <appName> in the default CORS origins.
HAEBOM_AIT_APP_NAME=haebomresearch

# Comma-separated participant API origins. Replaces the defaults when set.
# Token <appName> is replaced with HAEBOM_AIT_APP_NAME.
# Default patterns:
#   https://<appName>.apps.tossmini.com
#   https://<appName>.private-apps.tossmini.com
HAEBOM_PARTICIPANT_CORS_ORIGINS=

# Miniapp only (apps/haebom-participant). Origin of the Haebom server, no trailing path.
VITE_HAEBOM_API_BASE=
